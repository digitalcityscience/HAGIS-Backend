ARG GARAGE_IMAGE=dxflrs/garage:v2.3.0
FROM ${GARAGE_IMAGE} AS garage

# The upstream Garage image contains the static Garage binary. A tiny BusyBox
# runtime gives us a shell solely to render per-environment configuration at
# container start; credentials are never baked into an image or committed.
FROM busybox:1.36.1
COPY --from=garage /garage /garage
COPY entrypoint.sh /entrypoint.sh
RUN chmod 0555 /garage /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
